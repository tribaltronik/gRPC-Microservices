FROM golang:1.25-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /build/user-service ./services/user-service

RUN GRPC_HEALTH_PROBE_VERSION=v0.4.35 && \
    wget -qO/bin/grpc_health_probe https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe-linux-amd64 && \
    chmod +x /bin/grpc_health_probe

FROM gcr.io/distroless/static-debian12:nonroot

USER 1000:1000

COPY --from=builder /build/user-service /app/user-service
COPY --from=builder /bin/grpc_health_probe /bin/grpc_health_probe

EXPOSE 50051
EXPOSE 9091

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["/bin/grpc_health_probe", "-addr=:50051"]

ENTRYPOINT ["/app/user-service"]
