FROM golang:1.25-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /build/order-service ./services/order-service

RUN GRPC_HEALTH_PROBE_VERSION=v0.4.35 && \
    wget -qO/bin/grpc_health_probe https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe-linux-amd64 && \
    chmod +x /bin/grpc_health_probe

FROM gcr.io/distroless/static-debian12:nonroot

USER 1000:1000

COPY --from=builder /build/order-service /app/order-service
COPY --from=builder /bin/grpc_health_probe /bin/grpc_health_probe

EXPOSE 50052
EXPOSE 9092

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["/bin/grpc_health_probe", "-addr=:50052"]

ENTRYPOINT ["/app/order-service"]
